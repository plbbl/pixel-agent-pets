{
  "name": "dsh-pixel-agent-pets",
  "version": "0.3.1",
  "description": "Four local pixel companions for Codex desktop and official DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "pixel-pets": "./scripts/cli.mjs"
  },
  "files": [
    "dist",
    "assets",
    "codex",
    "codex-pixel",
    "scripts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "native",
    "assets-hd"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "setup": "node scripts/cli.mjs install",
    "doctor": "node scripts/cli.mjs doctor",
    "preview": "node scripts/preview.mjs",
    "preview:site": "node scripts/serve-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "build:site": "node scripts/build-site.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:media": "node scripts/build-media.mjs",
    "build:codex-native": "node scripts/build-codex-native.mjs",
    "build:installer": "node scripts/build-installer.mjs"
  },
  "dependencies": {
    "@electron/asar": "3.4.1",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "esbuild": "0.25.12",
    "gifenc": "1.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plbbl/pixel-agent-pets.git"
  },
  "homepage": "https://plbbl.github.io/pixel-agent-pets/"
}
